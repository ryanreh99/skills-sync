{
  "id": "claude",
  "name": "Claude Code",
  "config": {
    "order": 20,
    "adapter": "claude",
    "projectionVersion": 1
  },
  "skills": {
    "internalDir": ".claude/skills",
    "bindMode": "root",
    "targets": {
      "windows": {
        "dir": "%USERPROFILE%\\\\.claude\\\\skills"
      },
      "macos": {
        "dir": "$HOME/.claude/skills"
      },
      "linux": {
        "dir": "$HOME/.claude/skills"
      }
    },
    "support": {
      "nestedDiscovery": false,
      "instructions": true,
      "frontmatter": true,
      "scripts": false,
      "assets": true,
      "references": true,
      "helpers": false
    }
  },
  "commands": {
    "internalDir": ".claude/commands",
    "bindMode": "root",
    "kind": "markdown-files",
    "supportVersion": 1,
    "targets": {
      "windows": {
        "dir": "%USERPROFILE%\\\\.claude\\\\commands"
      },
      "macos": {
        "dir": "$HOME/.claude/commands"
      },
      "linux": {
        "dir": "$HOME/.claude/commands"
      }
    },
    "support": {
      "description": true,
      "args": true,
      "tags": false,
      "frontmatter": true
    }
  },
  "mcp": {
    "internalConfig": ".claude/mcp.json",
    "kind": "claude-json-type",
    "supportVersion": 1,
    "hasNonMcpConfig": true,
    "targets": {
      "windows": {
        "config": "%USERPROFILE%\\\\.claude.json"
      },
      "macos": {
        "config": "$HOME/.claude.json"
      },
      "linux": {
        "config": "$HOME/.claude.json"
      }
    },
    "support": {
      "transports": {
        "stdio": true,
        "streamableHttp": true,
        "sse": true
      },
      "auth": {
        "oauth": true,
        "bearerToken": true,
        "staticHeaders": true,
        "envHeaders": true
      },
      "capabilities": {
        "tools": true,
        "resources": true,
        "prompts": true
      },
      "config": {
        "command": true,
        "args": true,
        "env": true,
        "url": true,
        "scopes": true
      }
    }
  },
  "hooks": {
    "internalConfig": ".claude/hooks.json",
    "kind": "json-hooks",
    "supportVersion": 1,
    "hasNonHookConfig": true,
    "targets": {
      "windows": {
        "config": "%USERPROFILE%\\\\.claude.json"
      },
      "macos": {
        "config": "$HOME/.claude.json"
      },
      "linux": {
        "config": "$HOME/.claude.json"
      }
    },
    "support": {
      "actions": {
        "shell": true,
        "prompt": true,
        "http": true,
        "other": false
      },
      "events": {
        "sessionStart": true,
        "beforeAgent": true,
        "afterAgent": true,
        "beforeTool": true,
        "afterTool": true,
        "notification": true
      },
      "config": {
        "conditions": true,
        "timeoutMs": true,
        "retry": false,
        "async": true
      }
    }
  },
  "notes": [
    "Claude Code preserves imported skill folders and auxiliary files, but Anthropic's documented customization primitives are CLAUDE.md, subagents, slash commands, and hooks."
  ]
}
