{
  "id": "copilot",
  "name": "GitHub Copilot",
  "config": {
    "order": 40,
    "adapter": "copilot",
    "projectionVersion": 1
  },
  "skills": {
    "internalDir": ".copilot/skills",
    "bindMode": "root",
    "targets": {
      "windows": {
        "dir": "%USERPROFILE%\\\\.copilot\\\\skills"
      },
      "macos": {
        "dir": "$HOME/.copilot/skills"
      },
      "linux": {
        "dir": "$HOME/.copilot/skills"
      }
    },
    "support": {
      "nestedDiscovery": false,
      "instructions": true,
      "frontmatter": true,
      "scripts": false,
      "assets": true,
      "references": true,
      "helpers": false
    }
  },
  "commands": {
    "internalDir": ".copilot/commands",
    "bindMode": "root",
    "kind": "unsupported",
    "supportVersion": 1,
    "targets": {
      "windows": {
        "dir": "%USERPROFILE%\\\\.copilot\\\\commands"
      },
      "macos": {
        "dir": "$HOME/.copilot/commands"
      },
      "linux": {
        "dir": "$HOME/.copilot/commands"
      }
    },
    "support": {
      "description": false,
      "args": false,
      "tags": false,
      "frontmatter": false
    }
  },
  "mcp": {
    "internalConfig": ".copilot/mcp-config.json",
    "kind": "copilot-json-type",
    "supportVersion": 1,
    "hasNonMcpConfig": false,
    "targets": {
      "windows": {
        "config": "%USERPROFILE%\\\\.copilot\\\\mcp-config.json"
      },
      "macos": {
        "config": "$HOME/.copilot/mcp-config.json"
      },
      "linux": {
        "config": "$HOME/.copilot/mcp-config.json"
      }
    },
    "support": {
      "transports": {
        "stdio": true,
        "streamableHttp": true,
        "sse": true
      },
      "capabilities": {
        "tools": true,
        "resources": false,
        "prompts": false
      },
      "config": {
        "command": true,
        "args": true,
        "env": true,
        "url": true,
        "enabled": true
      }
    }
  },
  "hooks": {
    "internalConfig": ".copilot/hooks.json",
    "kind": "unsupported",
    "supportVersion": 1,
    "hasNonHookConfig": false,
    "targets": {
      "windows": {
        "config": "%USERPROFILE%\\\\.copilot\\\\hooks.json"
      },
      "macos": {
        "config": "$HOME/.copilot/hooks.json"
      },
      "linux": {
        "config": "$HOME/.copilot/hooks.json"
      }
    },
    "support": {
      "actions": {
        "shell": false,
        "prompt": false,
        "http": false,
        "other": false
      },
      "events": {
        "sessionStart": false,
        "beforeAgent": false,
        "afterAgent": false,
        "beforeTool": false,
        "afterTool": false,
        "notification": false
      },
      "config": {
        "conditions": false,
        "timeoutMs": false,
        "retry": false,
        "async": false
      }
    }
  },
  "notes": [
    "GitHub Copilot preserves imported skill directories and auxiliary files alongside its documented instruction and prompt-file features.",
    "Custom commands and hooks are intentionally unsupported in conservative user-scope-only v1."
  ]
}
